# Docker Compose Global Environment Template
# Copy to .env and configure secrets before launching containers: cp .env.example .env

# Database Configuration (PostgreSQL / Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# JWT Secret for Transaction Service (HMAC-SHA256, minimum 256 bits / 32 characters)
JWT_SECRET=<YOUR_SECURE_256_BIT_SECRET_HERE>
